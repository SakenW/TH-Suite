{
    "build": {
        "beforeDevCommand": "pnpm --filter minecraft-game-desktop-ui dev",
        "beforeBuildCommand": "pnpm build",
        "devPath": "http://localhost:1420",
        "distDir": "../ui/dist"
    },
    "package": {
        "productName": "Minecraft Modpack Translator",
        "version": "0.1.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "shell": {
                "all": false,
                "open": true
            },
            "fs": {
                "all": true,
                "scope": [
                    "$APP/*",
                    "$DESKTOP/*",
                    "$DOWNLOAD/*",
                    "**"
                ]
            },
            "dialog": {
                "all": true
            }
        },
        "windows": [
            {
                "title": "Minecraft Modpack Translator",
                "width": 1200,
                "height": 800
            }
        ],
        "bundle": {
            "active": true,
            "category": "DeveloperTool",
            "copyright": "",
            "deb": {
                "depends": []
            },
            "externalBin": [],
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ],
            "identifier": "com.transhub.minecraft.game",
            "longDescription": "",
            "macOS": {
                "entitlements": null,
                "exceptionDomain": "",
                "frameworks": [],
                "providerShortName": null,
                "signingIdentity": null
            },
            "resources": [],
            "shortDescription": "",
            "targets": "all",
            "windows": {
                "certificateThumbprint": null,
                "digestAlgorithm": "sha256",
                "timestampUrl": ""
            }
        },
        "security": {
            "csp": null
        },
        "updater": {
            "active": false
        }
    }
}